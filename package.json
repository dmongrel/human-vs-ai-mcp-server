{
  "name": "human-vs-ai-mcp-server",
  "version": "0.0.1",
  "description": "MCP server for detecting AI-generated text and offering humanizing recommendations.",
  "main": "dist/index.js",
  "bin": {
    "human-vs-ai-mcp-server": "dist/index.js"
  },
  "files": [
